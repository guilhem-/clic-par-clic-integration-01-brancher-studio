# Open WebUI : adresse et jeton d'un compte administrateur (Réglages › Compte › Clés API, ou jeton de session).
OWUI_URL=http://127.0.0.1:8080
OWUI_JETON=
# Studio 3D : adresse MCP interne au cluster et jeton fournis par l'équipe du studio.
STUDIO_URL=http://studio.studio3d.svc.cluster.local:8000/mcp
STUDIO_JETON=
# Modèle de base du modèle « Studio 3D » (identifiant tel qu'affiché dans Open WebUI).
MODELE_BASE=
# Groupe d'utilisateurs autorisés (créé s'il n'existe pas ; ses membres s'ajoutent dans Open WebUI).
GROUPE=Graphistes
